APP_NAME=mediation
HOST=0.0.0.0
PORT=8000

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

ASR_PROVIDER=tencent
REALTIME_ASR_SIMULATION=0
REALTIME_ASR_SIMULATION_INTERVAL_MS=900
TENCENT_ASR_APPID=1300915009
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
# 是否开启腾讯云实时语音识别的话者分离，1 开启，0 关闭。
TENCENT_ASR_SPEAKER_DIARIZATION=1
# 是否启用话者上下文；有上下文 ID 时可帮助多轮实时识别保持说话人一致性。
TENCENT_ASR_ENABLE_SPEAKER_CONTEXT=0
# 腾讯云返回或控制台配置的话者上下文 ID；没有就留空。
TENCENT_ASR_SPEAKER_CONTEXT_ID=
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_en_speaker_2.0

CASE_NO=A20260722-016
CASE_TITLE=故意伤害调解
